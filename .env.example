# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session & Super Admin Auth (Server-side only)
SESSION_SECRET=
ADMIN_PASSCODE=

# Router & RADIUS Secrets (Server-side only)
MIKROTIK_API_SECRET=
OMADA_CLIENT_SECRET=
RADIUS_SECRET=
WIREGUARD_SERVER_ENDPOINT=
WIREGUARD_SERVER_PUBLIC_KEY=

# Payment Gateways (Server-side only)
DALIPAY_API_URL=
DALIPAY_API_KEY=
DALIPAY_WEBHOOK_SECRET=

MPESA_API_URL=
MPESA_API_KEY=
MPESA_WEBHOOK_SECRET=

TIGOPESA_API_URL=
TIGOPESA_CLIENT_ID=
TIGOPESA_CLIENT_SECRET=
TIGOPESA_WEBHOOK_SECRET=

AIRTEL_API_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_WEBHOOK_SECRET=

SELCOM_API_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_WEBHOOK_SECRET=

AZAMPAY_API_URL=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_WEBHOOK_SECRET=

# Router Alert Email Transport (Server-side only — configure SMTP or Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
ALERT_FROM_EMAIL=

